// The catalog's AVBS-defined CONSUMER program — the language's `consumers:
// List<Mains<Set>>` surface, resolved at build time and run by the binary's
// `--consumers` mode (`spec_catalog::run_declared_consumers`). This closes the
// loop the unit test proves, but against the REAL emitted catalog:
//   query → solve → emit AlgorithmEntry → Main consumers run over them.
//
// The set MIXES first-class kinds — shell sorts AND quick-selects. `correctness`
// is kind-agnostic: it calls each entry's `run_correctness` pointer, which the
// emit wired to the per-kind `CorrectnessSuite` (sort battery vs quick-select
// battery). So ONE consumer program correctness-checks both kinds uniformly.
//
// Resolves to 9 + 9 + 28 = 46 algorithm labels under one `correctness` Main.

ShellSorts:        SortingAlgorithm = SortingAlgorithm<ShellSort<_>>
ShellSortsOrdered: SortingAlgorithm = SortingAlgorithm<ShellSortOrdered<_>>

// The nested quick-selects, built exactly like quick_select.avbs: a curated
// pivoted branch (24) then the heap-extract branch (4) = 28 recursive selects.
// Helpers prepend to LATER emittable families only — `qs_piv` above the pivoted
// family, `he` above the heap-extract family.
qs_piv: PartitionKind = _ where (
    Pivoted<scheme = (_ - {MovingPivot}), pivot = (_ - {MedianOfMedians})>
  | DualPivoted<CombinedSelector<FirstElement, FirstElement>>
  | DualPivoted<CombinedSelector<MiddleElement, MiddleElement>>
  | DualPivoted<CombinedSelector<FirstElement, LastElement>>
  | DualPivoted<NintherDualPivot>
)
QuickSelectsPiv: Selection = Selection<RecursiveQuickSelect<part = qs_piv>>
he: HeapExtractPart = _
QuickSelectsHe: Selection = Selection<RecursiveQuickSelect<part = he>>

SortsAndSelects: List<SortingAlgorithm> = [ShellSorts, ShellSortsOrdered, QuickSelectsPiv, QuickSelectsHe]
checks:          List<Mains<SortsAndSelects>> = [correctness]
