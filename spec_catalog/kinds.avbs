// First-class BUILDING-STONE KINDS — query OWNED by spec_catalog.
//
// One family per kind. Each `<Kind>Alg<X>` wrapper marks `X` emittable at the
// kind's role (the sort-track's `SortingAlgorithm<X>` / quick-select's
// `Selection<X>` analogue). Each kind uses its OWN role, distinct from the
// same-named slot-filler roles the merge/quick families use, so `_` enumerates
// only this kind's leaves.

// ── Rotations: every RotationKind leaf (11), no slots ──
Rotations: RotationAlg = RotationAlg<_>

// ── Small sorts: every SmallSortKind leaf (7), no slots ──
SmallSorts: SmallSortAlg = SmallSortAlg<_>

// ── Partitions: enumerate PartitionKind (the pk_pivoted driver), filling its
//    scheme × pivot slots = 5 × 6 = 30. Role enumeration (not a head reference)
//    so it can't collide with another family's same-named type-head. ──
Partitions: PartitionAlg = PartitionAlg<_>

// ── Merges: enumerate MergeKind (mk_naive + mk_smaller), filling the rot slot
//    (reuses RotationKind) = 2 × 11 = 22. Role enumeration: the type-heads
//    `NaiveRotationMerge`/`SmallerSideRotationMerge` ALSO exist as merge.spec
//    slot-fillers, so referencing them by head would be ambiguous. ──
Merges: MergeAlg = MergeAlg<_>
