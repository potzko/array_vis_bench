// SHELL families — query OWNED by this crate (gathered by `spec_catalog` via
// `[package.metadata.array_vis_bench] query = "shell.avbs"`). `_` is an
// exhaustive hole over the `seq` slot's role (GapSequence), so each family fans
// out to every sequence, the nine here and the six rod gap chains `rod.spec`
// declares, so {ShellSort, ShellSortOrdered} x 15 = 30 entries.

ShellSorts:        SortingAlgorithm = SortingAlgorithm<ShellSort<_>>
ShellSortsOrdered: SortingAlgorithm = SortingAlgorithm<ShellSortOrdered<_>>
