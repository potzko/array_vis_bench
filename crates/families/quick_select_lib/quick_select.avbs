// QUICK-SELECT families — query OWNED by quick_select_lib.
//
// `Selection<X>` wraps `X` as an emittable quick-select (role `QuickSelect`).
//
// ONE partition role-system (shared with quick). Each strategy is TWO bindings:
//   - a PIVOTED branch (24) — a curated slice of the shared `Pivoted<scheme,pivot>`
//     composites: 20 single (PartScheme−{moving pivot} × PartPivot−{median of
//     medians}) + 4 curated dual (first/first, middle/middle, first/last, ninther).
//   - a HEAP-EXTRACT branch (4) — the pivotless `HeapExtractPart` population.
// 24 + 4 = 28 per strategy × 2 = 56 (unchanged).
//
// The pivoted branches come FIRST so the `he` helper (which prepends to later
// families) never fans them; `he` sits just above the heap-extract branches.

RecursiveSelectPiv: Selection = Selection<RecursiveQuickSelect<part = _ where (
    Pivoted<scheme = (_ - {MovingPivot}), pivot = (_ - {MedianOfMedians})>
  | DualPivoted<CombinedSelector<FirstElement, FirstElement>>
  | DualPivoted<CombinedSelector<MiddleElement, MiddleElement>>
  | DualPivoted<CombinedSelector<FirstElement, LastElement>>
  | DualPivoted<NintherDualPivot>
)>>
IterativeSelectPiv: Selection = Selection<IterativeQuickSelect<part = _ where (
    Pivoted<scheme = (_ - {MovingPivot}), pivot = (_ - {MedianOfMedians})>
  | DualPivoted<CombinedSelector<FirstElement, FirstElement>>
  | DualPivoted<CombinedSelector<MiddleElement, MiddleElement>>
  | DualPivoted<CombinedSelector<FirstElement, LastElement>>
  | DualPivoted<NintherDualPivot>
)>>

he: HeapExtractPart = _
RecursiveSelectHe: Selection = Selection<RecursiveQuickSelect<part = he>>
IterativeSelectHe: Selection = Selection<IterativeQuickSelect<part = he>>
