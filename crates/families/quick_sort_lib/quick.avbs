// QUICK families — query OWNED by this crate.
//
// The quick driver slots ONE self-pivoting partition (`part: PartitionKind`); the
// composite `Pivoted<scheme, pivot>` carries the pivot internally with its arity
// baked in. So the query just fans `part` over every PartitionKind (5×5 single +
// 26 dual = 51) and `small_sort` over the family's small-sort role — the old
// `Partition[pivot = p]` pivot↔partition coupling is gone.
//
// Each family: 51 partitions × 4 small sorts = 204 variants (408 total).

QuickSorts:         SortingAlgorithm = SortingAlgorithm<CanonicalQuickSort<part = _, small_sort = _>>
DeferredQuickSorts: SortingAlgorithm = SortingAlgorithm<DeferredCanonicalQuickSort<part = _, small_sort = _>>
