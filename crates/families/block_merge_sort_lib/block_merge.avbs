// Block merge family, query owned by block_merge_sort_lib. Fifteen buffers (in
// the array or external, by seven sizes, or none) by two key shapes by fifteen
// rotations, every one carving by the scan and merging by the smaller side, 450
// entries. Then the extraction study: the other four extractions over the
// WikiSort, dynamic GrailSort and bufferless shapes with in array keys, by the
// reversal, trinity and auxiliary rotations, 36 entries. The partition extraction
// over the masked partition, by either walk, is left out of the study.

BlockMergeSorts: SortingAlgorithm = SortingAlgorithm<BlockMergeSort<buffer = _, keys = _, rot = _, extract = _ where ( ScanExtraction ), merge = _ where ( SmallerSideMerge )>>

BlockMergeExtractions: SortingAlgorithm = SortingAlgorithm<BlockMergeSort<
    buffer = _ where ( InArrayBuffer<Sqrt> | ExternalBuffer<Sqrt> | bb_none ),
    keys = _ where ( InArrayKeys ),
    rot = _ where ( ReversalRotation | TrinityRotation | AuxiliaryRotation ),
    extract = _ - { ScanExtraction, PartitionExtraction<Masked<_>> },
    merge = _ where ( SmallerSideMerge )
>>
