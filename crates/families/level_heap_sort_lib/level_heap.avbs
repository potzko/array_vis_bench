// Level heap family, queries owned by level_heap_sort_lib. Four buffer sizes,
// the logarithm, 512, the square root and a sixteenth, by the rotation
// partition or the block partition the sort lends its buffer to, and every
// rotation. A buffer in the array marks its dead cells in bytes or in the
// array, the bits being the bytes a little slower; one outside it in bytes or
// in bits, having no need to carve its marks. 240 entries each, 480.

LevelHeapInArray: SortingAlgorithm = SortingAlgorithm<LevelHeapSort<
    buffer = _ where ( InArrayBuffer<Log> | InArrayBuffer<size_512> | InArrayBuffer<Sqrt> | InArrayBuffer<Sixteenth> ),
    marks = _ where ( ByteMarks | InArrayMarks ),
    part = _ where ( RotationPartition | BlockPartition ),
    rot = _
>>

LevelHeapExternal: SortingAlgorithm = SortingAlgorithm<LevelHeapSort<
    buffer = _ where ( ExternalBuffer<Log> | ExternalBuffer<size_512> | ExternalBuffer<Sqrt> | ExternalBuffer<Sixteenth> ),
    marks = _ where ( ByteMarks | BitMarks ),
    part = _ where ( RotationPartition | BlockPartition ),
    rot = _
>>
